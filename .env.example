# ElectricQuery environment variables example
# Copy this file to .env and fill secrets before running docker compose.
#
# Notes:
#   - HOST_PERSIST_ROOT defines the host directory used for persistent logs and data.
#     It is relative to the directory where docker-compose.yml is located.
#   - HOST_CONFIG_FILE points to the host application.conf file mounted into the
#     container as /app/application.conf (read-only).
#   - application.conf.example uses HOCON and can contain # or // comments.
#     Copy application.conf.example to application.conf and replace placeholder values.

EQ_MODE=debug
EQ_JWT_SECRET=change-me-in-production
EQ_INTERNAL_TOKEN=change-me-in-production
EQ_ADMIN_TOKEN=change-me-in-production
# Required when EQ_MODE is not debug. Example: https://electricquery.example.com
EQ_ALLOWED_ORIGIN=

# Database configuration
EQ_DB_DRIVER=sqlite
EQ_SQLITE_PATH=/app/data/electricquery.db
EQ_DB_MAX_OPEN=25
EQ_DB_MAX_IDLE=5
# EQ_DB_DRIVER=mysql
# EQ_MYSQL_HOST=mysql.example.com
# EQ_MYSQL_PORT=3306
# EQ_MYSQL_USER=root
# EQ_MYSQL_PASSWORD=
# EQ_MYSQL_DBNAME=electricquery
# EQ_MYSQL_CHARSET=utf8mb4
# EQ_MYSQL_LOC=Asia%2FShanghai

# Logging
EQ_LOG_LEVEL=info
EQ_LOG_PATH=/app/logs/app.log
EQ_LOG_MAX_SIZE_MB=10
EQ_LOG_MAX_BACKUPS=7
EQ_LOG_MAX_AGE_DAYS=30
EQ_LOG_COMPRESS=true
EQ_LOG_CONSOLE=false

# SMTP / notification
EQ_SMTP_ENABLED=false
EQ_SMTP_SERVER=
EQ_SMTP_PORT=465
EQ_SMTP_USER=
EQ_SMTP_PASSWORD=
EQ_SMTP_USE_SSL=true

# Host persistence configuration
# Set the local directory where logs and data will be persisted.
# Example: HOST_PERSIST_ROOT=./persist
HOST_PERSIST_ROOT=./persist

# Set the path to your host-side application.conf file.
# By default docker-compose.yml mounts application.conf.example. Change this to
# ./application.conf after copying and editing a real config file.
HOST_CONFIG_FILE=./application.conf.example

# Power checker
EQ_LOGIN_URL=
EQ_TIMEOUT_SECONDS=30

# Scheduler
EQ_POLL_INTERVAL=3600
EQ_WEEKLY_REPORT_WEEKDAY=1
EQ_WEEKLY_REPORT_HOUR=8
